# Contract performance benchmark overrides (copy to .env)

# Backend under test
CONTRACT_BACKEND_URL=https://localhost:4000
# CONTRACT_PATH_PREFIX=
CONTRACT_TLS_INSECURE=true
CONTRACT_HTTP_TIMEOUT=60
CONTRACT_SSE_TIMEOUT=120
# CONTRACT_TOKEN=   # default: oc whoami -t

# Optional catalog filter (same as contract tests)
# CONTRACT_GROUP=auth

# Benchmark run
BENCHMARK_LABEL=run
BENCHMARK_RUNS=3
BENCHMARK_WARMUP=false
# BENCHMARK_DIR=generated/benchmarks
# BENCHMARK_NOTES=node backend baseline

# Console git metadata
# CONSOLE_REPO=/path/to/console

# Progress and sampling
PERF_VERBOSE=true
PERF_PROGRESS_INTERVAL=5
PERF_SAMPLE_INTERVAL=1
LOCAL_BACKEND_PORT=4000
