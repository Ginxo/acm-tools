# Copy to .env and fill in (never commit .env)
# HUB_API=https://api.example.com:6443
# HUB_USER=kubeadmin
# HUB_PASS=

CONSOLE_NS=open-cluster-management
# CONSOLE_BACKEND=auto   # auto | mce | acm — auto prefers MCE console-mce-console
# CONSOLE_DEPLOY=console-mce-console
# CONSOLE_NS=multicluster-engine
CLUSTER_PREFIX=mock-sno
CLUSTER_WIDTH=4
BATCH_SIZE=10
BATCH_SLEEP=2

# Hive layer B
FLEET_IMAGE_SET=perf-img-stub
FLEET_BASE_DOMAIN=perf.example.com

# Governance (apply-governance.sh) — auto-detected if omitted
# GOVERNANCE_NS=perf-governance
# GOVERNANCE_NS=acm-43194-governance
# POLICY_NAMES=perf-policy1,perf-policy2,perf-policy3

# SSE measurement (measure-sse.sh)
# SSE_MODE=plugins   # npm run plugins — browser URL via localhost:9000 (recommended for dev)
# SSE_MODE=local     # direct https://127.0.0.1:4000/events (backend only)
# SSE_MODE=plugin-dev # https://127.0.0.1:3002/multicloud/events (webpack proxy)
# SSE_MODE=direct    # port-forward to console-mce-console on hub
# SSE_MODE=proxy     # remote OCP console route (set CONSOLE_URL)
# DEV_CONSOLE_URL=http://127.0.0.1:9000
# CONSOLE_PORT=9000
# MCE_PORT=3002
# CONSOLE_PLUGIN=mce
# SSE_COOKIE=openshift-session-token=...; csrf-token=...
SSE_MAX_SECONDS=600
SSE_LOCAL_PORT=19443
# SSE_PROGRESS_INTERVAL=5   # progress on stderr every N seconds (0 = off)
# SSE_GZIP=1                # request gzip (default off — identity avoids http.client stall)
# GATE_QUIET=1              # suppress gate-density progress on stderr
# SSE_SAVE=generated/events-stream.bin

# SSE benchmarks (benchmark-sse.sh)
# BENCHMARK_LABEL=baseline
# BENCHMARK_RUNS=3
# BENCHMARK_WARMUP=true
# BENCHMARK_DIR=generated/benchmarks
# BENCHMARK_NOTES=branch or JIRA id
# CONSOLE_REPO=/path/to/console
